<%# Home page (no search yet): introduction and the top-level collections. %>
<% collections, total = top_level_collections %>

<div class="p-4 p-md-5 mb-4 bg-body-tertiary border rounded-3">
  <h1 class="fw-bold"><%= t('preservica.home.heading') %></h1>
  <p class="lead mb-0"><%= t('preservica.home.intro') %></p>
</div>

<% if collections.any? %>
  <section aria-labelledby="home-collections-heading">
    <h2 id="home-collections-heading" class="h4 mb-3"><%= t('preservica.home.collections') %></h2>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
      <% collections.each do |doc| %>
        <div class="col">
          <div class="card h-100">
            <% if (thumb = preservica_thumbnail_url(doc)) %>
              <%= image_tag thumb, alt: '', class: 'card-img-top', style: 'object-fit: cover; height: 10rem;', loading: 'lazy' %>
            <% end %>
            <div class="card-body">
              <h3 class="h6 card-title">
                <%= link_to Array(doc['title_tesim']).first.presence || 'Untitled collection', solr_document_path(doc.id),
                            class: 'stretched-link' %>
              </h3>
              <% if (summary = Array(doc['abstract_tesim']).first).present? %>
                <p class="card-text small text-body-secondary"><%= truncate(strip_tags(summary), length: 160, separator: ' ') %></p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <% if total > collections.size %>
      <p class="mt-3">
        <%= link_to t('preservica.home.all_collections', count: total), search_catalog_path(f: { level: ['top'] }, sort: 'title') %>
      </p>
    <% end %>
    <p class="mt-3">
      <%= link_to t('preservica.home.browse_all'), search_catalog_path(search_field: 'all_fields', q: ''), class: 'btn btn-outline-primary' %>
    </p>
  </section>
<% end %>
