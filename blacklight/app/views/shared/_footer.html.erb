<%# Site footer, overriding Blacklight's shared/footer partial. Mirrors the Rod Library website footer (library.uni.edu). %>
<footer class="mt-5 site-footer" style="background: #2E1A47; color: #E5E1E6">
  <div style="max-width: 1280px; margin: 0 auto; padding: 40px 24px 24px; display: flex; flex-direction: column; gap: 28px">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 32px">
      <section aria-labelledby="ft-rod" style="display: flex; flex-direction: column; gap: 8px">
        <h2 id="ft-rod" style="margin: 0; font-family: Bookmania, Georgia, serif; font-size: 20px; color: #ffffff">Rod Library</h2>
        <p style="margin: 0; font-size: 14px; line-height: 1.6">University of Northern Iowa<br>1227 W. 27th Street<br>Cedar Falls, IA 50614-3675<br><a href="tel:+13192732838" style="color: #FFB500">(319) 273-2838</a></p>
        <ul style="list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; gap: 4px; font-size: 14px">
          <li><a href="https://library.uni.edu/about-us/hours" style="color: #FFB500">Hours</a></li>
          <li><a href="https://library.uni.edu/ask-us-research-help" style="color: #FFB500">Ask Us! for Research Help</a></li>
          <li><a href="https://library.uni.edu/about-us/contact-us" style="color: #FFB500">Contact Us</a></li>
          <li><a href="https://library.uni.edu/about-us/accessibility-services" style="color: #FFB500">Accessibility Services</a></li>
          <li><a href="https://library.uni.edu/make-gift-rod-library" style="color: #FFB500">Make a Gift to the Library</a></li>
        </ul>
      </section>
      <section aria-labelledby="ft-connect" style="display: flex; flex-direction: column; gap: 8px">
        <h2 id="ft-connect" style="margin: 0; font-family: Bookmania, Georgia, serif; font-size: 20px; color: #ffffff">Connect With Us!</h2>
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; font-size: 14px">
          <li><a href="https://www.facebook.com/rodlibrary" style="color: #FFB500">Facebook</a></li>
          <li><a href="https://twitter.com/RodLibrary" style="color: #FFB500">X (Twitter)</a></li>
          <li><a href="https://www.youtube.com/@rodlibrary_UNI" style="color: #FFB500">YouTube</a></li>
          <li><a href="https://instagram.com/rodlibrary" style="color: #FFB500">Instagram</a></li>
        </ul>
      </section>
      <section aria-labelledby="ft-uni" style="display: flex; flex-direction: column; gap: 8px">
        <h2 id="ft-uni" style="margin: 0; font-family: Bookmania, Georgia, serif; font-size: 20px; color: #ffffff"><a href="https://uni.edu" style="color: #ffffff; text-decoration: none">University of Northern Iowa</a></h2>
        <p style="margin: 0; font-size: 14px; line-height: 1.6">1227 W 27th St<br>Cedar Falls, Iowa 50614<br><a href="tel:+13192732311" style="color: #FFB500">319-273-2311</a></p>
        <ul style="list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; gap: 4px; font-size: 14px">
          <li><a href="https://map.uni.edu/" style="color: #FFB500">Maps &amp; Directions</a></li>
          <li><a href="https://unibookstore.com" style="color: #FFB500">Bookstore</a></li>
          <li><a href="https://safety.uni.edu" style="color: #FFB500">Safety</a></li>
          <li><a href="https://insideuni.uni.edu" style="color: #FFB500">InsideUNI</a></li>
          <li><a href="https://careers.uni.edu" style="color: #FFB500">Careers at UNI</a></li>
          <li><a href="https://freespeech.uni.edu" style="color: #FFB500">Free Speech at UNI</a></li>
        </ul>
      </section>
    </div>
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-top: 20px; border-top: 1px solid #51284F; font-size: 14px">
      <span>Copyright <%= Date.current.year %> · Maintained by <a href="mailto:webteam@uni.edu" style="color: #FFB500">IT-Client Services</a></span>
      <span style="display: flex; flex-wrap: wrap; gap: 14px"><a href="https://www.facebook.com/universityofnortherniowa" style="color: #FFB500">Facebook</a><a href="https://x.com/northerniowa" style="color: #FFB500">X</a><a href="https://www.youtube.com/user/uofnortherniowa" style="color: #FFB500">YouTube</a><a href="https://www.linkedin.com/school/university-of-northern-iowa/" style="color: #FFB500">LinkedIn</a><a href="https://www.instagram.com/northern_iowa/" style="color: #FFB500">Instagram</a></span>
