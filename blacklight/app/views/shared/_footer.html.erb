    <nav aria-label="University policies" style="display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 13px">
      <a href="https://policies.uni.edu/1303" style="color: #E5E1E6">Equal Opportunity/Non-Discrimination Statement</a>
      <a href="https://uni.edu/resources/privacy-statement" style="color: #E5E1E6">Privacy Statement</a>
      <a href="https://uni.edu/resources/accessibility" style="color: #E5E1E6">Accessibility</a>
      <a href="https://uni.edu/resources/consumer-info" style="color: #E5E1E6">Consumer Information</a>
    </nav>
  </div>
</footer>
