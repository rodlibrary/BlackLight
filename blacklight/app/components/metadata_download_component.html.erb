<section class="metadata-download my-4" aria-labelledby="<%= heading_id %>">
  <h2 id="<%= heading_id %>" class="h5"><%= t('preservica.metadata_download.heading') %></h2>
  <p class="mb-1">
    <%= link_to t('preservica.metadata_download.button'), url, download: filename, type: 'application/mods+xml',
                class: 'btn btn-outline-primary btn-sm' %>
  </p>
  <p class="small text-body-secondary mb-0"><%= t('preservica.metadata_download.note') %></p>
</section>
