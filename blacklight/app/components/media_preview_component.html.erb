<section class="media-preview mb-4" aria-label="Preview">
  <% if handoff? %>
    <div class="preservica-handoff card">
      <div class="card-body d-flex flex-wrap align-items-center gap-4">
        <% if thumbnail_url.present? %>
          <%= image_tag thumbnail_url, alt: '', class: 'rounded border', style: 'max-width: 220px; max-height: 220px; object-fit: contain;', loading: 'lazy' %>
        <% end %>
        <div style="flex: 1 1 280px;">
          <h2 class="h4"><%= handoff_text('heading') %></h2>
          <p><%= handoff_text('text') %></p>
          <%= helpers.new_tab_link_to handoff_text('button'), landing_url, class: 'btn btn-primary btn-lg' %>
          <p class="small text-body-secondary mt-2 mb-0"><%= t('preservica.handoff.note') %></p>
        </div>
      </div>
    </div>
  <% elsif iiif_viewer_src %>
    <div class="ratio ratio-4x3 mb-2">
      <iframe src="<%= iiif_viewer_src %>" title="Viewer: <%= title %>" allowfullscreen loading="lazy"></iframe>
    </div>
    <p class="small">
      <% if landing_url.present? %>
        <%= helpers.new_tab_link_to t('preservica.handoff.viewer_link'), landing_url %> ·
      <% end %>
      <%= helpers.new_tab_link_to 'IIIF manifest', iiif_manifest %>
    </p>
  <% elsif iiif_manifest.present? %>
    <p>
      <%= helpers.new_tab_link_to 'IIIF manifest', iiif_manifest, class: 'btn btn-outline-primary' %>
    </p>
  <% elsif media_type == 'image' %>
    <%= image_tag media_url, alt: title, class: 'img-fluid rounded', style: 'max-height: 600px;', loading: 'lazy' %>
  <% elsif media_type == 'video' && youtube_id %>
    <div class="ratio ratio-16x9">
      <iframe src="https://www.youtube-nocookie.com/embed/<%= youtube_id %>" title="<%= title %>"
              allowfullscreen loading="lazy"></iframe>
    </div>
  <% elsif media_type == 'video' && vimeo_id %>
    <div class="ratio ratio-16x9">
      <iframe src="https://player.vimeo.com/video/<%= vimeo_id %>" title="<%= title %>"
              allowfullscreen loading="lazy"></iframe>
    </div>
  <% elsif media_type == 'video' %>
    <video controls preload="metadata" class="w-100" style="max-height: 480px;" crossorigin="anonymous">
      <source src="<%= media_url %>">
      <% if captions_url %>
        <track kind="captions" src="<%= captions_url %>" srclang="en" label="Captions" default>
      <% end %>
      <%= link_to 'Download the video', media_url %>
    </video>
  <% elsif media_type == 'audio' %>
    <%# <audio> can't display captions, so the transcript is offered as a link. %>
    <audio controls preload="metadata" class="w-100">
      <source src="<%= media_url %>">
      <%= link_to 'Download the audio', media_url %>
    </audio>
    <% if captions_url %>
      <p class="small mt-2"><%= helpers.new_tab_link_to 'Transcript (WebVTT)', captions_url %></p>
    <% end %>
  <% elsif media_type == 'pdf' && media_url.present? %>
    <object data="<%= media_url %>" type="application/pdf" class="w-100" style="height: 600px;" aria-label="<%= title %>">
      <p>This browser can't show the PDF here. <%= helpers.new_tab_link_to 'Open the PDF', media_url %>.</p>
    </object>
  <% elsif thumbnail_url.present? %>
    <%= image_tag thumbnail_url, alt: '', class: 'img-fluid rounded border', style: 'max-height: 400px;', loading: 'lazy' %>
  <% end %>

  <% if media_url.present? %>
    <p class="mt-2">
      <%= helpers.new_tab_link_to 'Download / view file', media_url, class: 'btn btn-sm btn-primary' %>
    </p>
  <% end %>
</section>
